---
import { Icon } from "astro-icon/components";
import { NAV, SITE } from "@astro-theme-site/config";
import { sitePath } from "../utils/site";

const links = NAV.footer.map((item) => ({
  ...item,
  href: item.href.startsWith("/") ? sitePath(item.href) : item.href,
}));
---

<footer class="site-footer" aria-label="Site footer">
  <nav aria-label="Footer navigation">
    {
      links.map((item) => (
        <a href={item.href}>
          {item.icon && <Icon name={item.icon} width={14} height={14} />}
          {item.label}
        </a>
      ))
    }
  </nav>
  {
    SITE.contentLicense && (
      <p>
        Site content is available under <a href={SITE.contentLicense.url}>
          {SITE.contentLicense.label}
        </a>.
      </p>
    )
  }
</footer>
