---
import BaseLayout from "@tsche/astro-blog-theme/layouts/BaseLayout.astro";
import { SITE } from "@astro-theme-site/config";
import TableOfContents from "../components/TableOfContents.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description?: string;
  crumbs?: Array<{ label: string; href?: string }>;
  /** Load KaTeX CSS for this page only (no global load). */
  math?: boolean;
  /** Hide the rendered title and description header. */
  showHeader?: boolean;
  /** Render the page table of contents when headings are available. */
  toc?: boolean;
  /** Astro's headings array used to render the page table of contents. */
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  crumbs,
  math = false,
  showHeader = true,
  toc = true,
  headings = [],
} = Astro.props;

let MathStylesComponent;
if (math) {
  MathStylesComponent = (await import("../components/MathStyles.astro"))
    .default;
}

const articleClass = SITE.boxedArticles
  ? "border-base-300 bg-base-100 rounded-md border px-5 py-8 sm:px-8 sm:py-10"
  : "px-1 py-6 sm:px-2 sm:py-8";
---

<BaseLayout
  title={title}
  description={description}
  crumbs={crumbs ?? [{ label: title }]}
>
  {math && MathStylesComponent && <MathStylesComponent />}
  {
    toc && headings.length > 0 && (
      <TableOfContents slot="aside-bottom" title={title} headings={headings} />
    )
  }
  <article class={articleClass}>
    {
      showHeader && (
        <header class="mb-6">
          <h1 class="text-3xl leading-tight font-extrabold tracking-tight">
            {title}
          </h1>
          {description && (
            <p class="text-base-content/70 mt-2">{description}</p>
          )}
        </header>
      )
    }
    <div class="prose-site max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
