---
import BaseLayout from "@tsche/astro-blog-theme/layouts/BaseLayout.astro";
import PostNav from "../components/PostNav.astro";
import SmartImage from "../components/SmartImage.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Giscus from "../components/Giscus.astro";
import { Icon } from "astro-icon/components";
import { GISCUS, SITE } from "@astro-theme-site/config";
import { t } from "../ui";
import { formatDate, isoDate, sitePath } from "../utils/site";
import { readingTime } from "../utils/reading-time";
import {
  contentType,
  type Post,
  tagPath,
  categoryPath,
  postSlug,
  postAuthors,
  heroImage,
  heroImageSrc,
  shouldShowHero,
} from "../utils/posts";
import { buildSeo } from "../utils/seo";
import type { MarkdownHeading } from "astro";

interface Props {
  post: Post;
  /** Astro's `headings` array from `await render(post)`. */
  headings: MarkdownHeading[];
  /** Raw body string used for reading time. */
  body: string;
  prev?: Post;
  next?: Post;
}

const { post, headings, body, prev, next } = Astro.props;
const minutes = readingTime(body).minutes;
const type = contentType(post);
const typeConfig = SITE.contentTypes[type];
if (!typeConfig) throw new Error(`Content type "${type}" is not enabled.`);
const authors = postAuthors(post);

const commentsEnabled = post.data.comments !== false && GISCUS.enabled;

const heroSrc = heroImageSrc(post);
const heroAsset = heroImage(post);
const showHero = shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? "";

const articleClass = SITE.boxedArticles
  ? "border-base-300 bg-base-100 rounded-md border px-5 py-8 sm:px-8 sm:py-10"
  : "px-1 py-6 sm:px-2 sm:py-8";

// Use hero image for OG if available, otherwise fallback to the generated OG image
// (unless Auto-OG is disabled globally or skipped in CI).
const ogSlug = postSlug(post);
const generatedOgPath = `/og/${post.id.split("/")[0]}/${ogSlug}.png`;
const skipAutoOg =
  !SITE.autoOgImage || import.meta.env.CI_SKIP_AUTO_OG_IMAGE === "true";
const ogImage = heroSrc ?? (skipAutoOg ? undefined : generatedOgPath);

const seo = buildSeo({
  title: post.data.title,
  description: post.data.description,
  fullPath: post.data.canonicalURL ?? Astro.url.pathname,
  ogImage,
  type: "article",
  publishedTime: post.data.pubDate,
  modifiedTime: post.data.updatedDate,
  tags: post.data.tags,
  // An unlisted post hides from SEO by default unless the author
  // explicitly sets `unlistedHideFromSeo: false`.
  noindex: post.data.unlisted && (post.data.unlistedHideFromSeo ?? true),
});

let MathStylesComponent;
if (post.data.math) {
  MathStylesComponent = (await import("../components/MathStyles.astro"))
    .default;
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  seo={seo}
  hidePanel={!post.data.toc || headings.length === 0}
>
  {post.data.math && MathStylesComponent && <MathStylesComponent />}
  {
    post.data.toc && headings.length > 0 && (
      <TableOfContents slot="aside-bottom" headings={headings} />
    )
  }

  <article
    class:list={[articleClass, `post-entry post-entry--${type}`]}
    data-content-type={type}
  >
    <header class="mb-8">
      <h1
        class="post-title text-base-content text-3xl leading-tight font-extrabold tracking-tight sm:text-[2.5rem]"
      >
        {post.data.title}
      </h1>
      <p class="text-base-content/65 mt-3 text-lg">{post.data.description}</p>

      <div
        class="post-meta text-base-content/70 mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm"
      >
        <a
          href={sitePath(`/${type}`)}
          class={`content-label content-label--${type === "articles" ? "article" : type.slice(0, -1)}`}
        >
          {typeConfig.singularLabel}
        </a>
        <span class="post-byline">
          <span>By</span>{" "}
          {
            authors.map((author, index) => (
              <>
                {index > 0 && <span>, </span>}
                {author.url ? (
                  <a href={author.url}>{author.name}</a>
                ) : (
                  <span>{author.name}</span>
                )}
              </>
            ))
          }
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:calendar-days" width={14} height={14} />
          <time datetime={isoDate(post.data.pubDate)}
            >{formatDate(post.data.pubDate)}</time
          >
        </span>
        {
          post.data.updatedDate && (
            <span class="inline-flex items-center gap-1">
              <Icon name="lucide:check" width={14} height={14} />
              <time datetime={isoDate(post.data.updatedDate)}>
                {t("post.updatedOn")} {formatDate(post.data.updatedDate)}
              </time>
            </span>
          )
        }
        {
          post.data.categories.length > 0 && (
            <span class="inline-flex items-center gap-1">
              <Icon name="lucide:folder" width={14} height={14} />
              {post.data.categories.map((c, i) => (
                <>
                  {i > 0 && <span class="text-base-content/40 mx-0.5">,</span>}
                  <a href={categoryPath(c)} class="hover:text-primary">
                    {c}
                  </a>
                </>
              ))}
            </span>
          )
        }
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:clock" width={14} height={14} />
          {minutes}
          {t("post.readingTime")}
        </span>
      </div>
    </header>

    {
      showHero && heroAsset && (
        <figure class="post-hero mb-8">
          <div class="post-hero__frame">
            <SmartImage
              src={heroAsset}
              alt={heroAlt}
              class="post-hero__img"
              loading="eager"
              widths={[480, 768, 1024, 1280, 1600]}
              sizes="(max-width: 768px) 100vw, 1024px"
              quality={82}
            />
          </div>
          {heroAlt && (
            <figcaption class="text-base-content/70 mt-2 text-center text-xs">
              {heroAlt}
            </figcaption>
          )}
        </figure>
      )
    }

    <div class="prose-site max-w-none">
      <slot />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="border-base-300 mt-10 flex flex-wrap items-center gap-2 border-t pt-6">
          <span class="text-base-content/70 text-sm font-semibold tracking-wide uppercase">
            {t("post.tags")}
          </span>
          {post.data.tags.map((tag) => (
            <a href={tagPath(tag)} class="post-tag text-xs">
              {tag}
            </a>
          ))}
        </footer>
      )
    }

    {
      commentsEnabled ? (
        <Giscus />
      ) : (
        post.data.comments === false && (
          <p class="text-base-content/70 mt-10 text-sm">
            {t("post.commentsDisabled")}
          </p>
        )
      )
    }

    <PostNav prev={prev} next={next} />
  </article>
</BaseLayout>
