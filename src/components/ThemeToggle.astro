---
import { Icon } from "astro-icon/components";

interface Props {
  label?: string;
  lightLabel?: string;
  darkLabel?: string;
}

const {
  label = "Toggle theme",
  lightLabel = "Light",
  darkLabel = "Dark",
} = Astro.props;
---

<button
  type="button"
  class="site-social"
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <span data-theme-icon="light" class="hidden">
    <Icon
      name="lucide:sun"
      width={18}
      height={18}
      aria-label={lightLabel}
      role="img"
    />
  </span>
  <span data-theme-icon="dark" class="hidden">
    <Icon
      name="lucide:moon"
      width={18}
      height={18}
      aria-label={darkLabel}
      role="img"
    />
  </span>
</button>

<script>
  type Theme = "astro-blog-light" | "astro-blog-dark";
  const STORAGE_KEY = "theme";

  function currentTheme(): Theme {
    return (
      (document.documentElement.getAttribute("data-theme") as Theme) ??
      "astro-blog-light"
    );
  }

  function commitTheme(theme: Theme, save = true): void {
    document.documentElement.setAttribute("data-theme", theme);
    if (save) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        /* ignore */
      }
    }
    updateIcons(theme);
    document.dispatchEvent(
      new CustomEvent("theme-change", { detail: { theme } }),
    );
  }

  /**
   * Apply a theme. When the View Transitions API is available and the
   * caller supplies a click event, animate a circular reveal from the
   * cursor; otherwise fall back to an instant swap.
   */
  function applyTheme(theme: Theme, origin?: { x: number; y: number }): void {
    const supportsVT =
      typeof (document as unknown as { startViewTransition?: unknown })
        .startViewTransition === "function";
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!supportsVT || reduceMotion || !origin) {
      commitTheme(theme);
      return;
    }

    const root = document.documentElement;
    root.style.setProperty("--theme-x", `${origin.x}px`);
    root.style.setProperty("--theme-y", `${origin.y}px`);
    const dx = Math.max(origin.x, window.innerWidth - origin.x);
    const dy = Math.max(origin.y, window.innerHeight - origin.y);
    const radius = Math.hypot(dx, dy);
    // Add a safety margin to prevent edge flickering on extremely large or high-DPI viewports.
    root.style.setProperty("--theme-radius", `${radius + 100}px`);
    root.dataset.themeAnim =
      theme === "astro-blog-dark" ? "to-dark" : "to-light";

    const transition = (
      document as unknown as {
        // eslint-disable-next-line no-unused-vars
        startViewTransition: (cb: () => void) => { finished: Promise<void> };
      }
    ).startViewTransition(() => {
      commitTheme(theme);
    });
    transition.finished.finally(() => {
      delete root.dataset.themeAnim;
    });
  }

  function updateIcons(theme: Theme): void {
    document
      .querySelectorAll<HTMLElement>("[data-theme-icon]")
      .forEach((el) => {
        const want = theme === "astro-blog-dark" ? "light" : "dark";
        el.classList.toggle("hidden", el.dataset.themeIcon !== want);
      });
  }

  function init(): void {
    updateIcons(currentTheme());
    document
      .querySelectorAll<HTMLElement>("[data-theme-toggle]")
      .forEach((btn) => {
        btn.addEventListener("click", (event) => {
          const next: Theme =
            currentTheme() === "astro-blog-dark"
              ? "astro-blog-light"
              : "astro-blog-dark";
          const rect = btn.getBoundingClientRect();
          const origin = {
            x: (event as MouseEvent).clientX || rect.left + rect.width / 2,
            y: (event as MouseEvent).clientY || rect.top + rect.height / 2,
          };
          applyTheme(next, origin);
        });
      });
    // Sync with system preference if user hasn't pinned a theme yet.
    const mql = window.matchMedia("(prefers-color-scheme: dark)");
    mql.addEventListener("change", (e) => {
      try {
        if (localStorage.getItem(STORAGE_KEY)) return;
      } catch {
        /* ignore */
      }
      // Apply visually only — do not persist so the system preference
      // remains the source of truth until the user explicitly toggles.
      commitTheme(e.matches ? "astro-blog-dark" : "astro-blog-light", false);
    });
  }

  // `astro:page-load` fires on initial load AND after each client-side
  // navigation (DOM is swapped so old listeners are gone). Using only
  // this event avoids double-binding on first load which would fire two
  // startViewTransition() calls and cancel the animation.
  document.addEventListener("astro:page-load", init);
</script>
