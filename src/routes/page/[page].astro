---
import BaseLayout from "@tsche/astro-blog-theme/layouts/BaseLayout.astro";
import PostList from "@tsche/astro-blog-theme/components/PostList.astro";
import Pagination from "@tsche/astro-blog-theme/components/Pagination.astro";
import { SITE } from "@astro-theme-site/config";
import { t } from "@tsche/astro-blog-theme/ui";
import { sitePath } from "@tsche/astro-blog-theme/site";
import { getPosts } from "@tsche/astro-blog-theme/posts";

interface Props {
  current: number;
  last: number;
}

export async function getStaticPaths() {
  const allPosts = await getPosts();
  const totalPages = Math.ceil(allPosts.length / SITE.postsPerPage);
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({
      params: { page: String(i) },
      props: { current: i, last: totalPages },
    });
  }
  return paths;
}

const { current, last } = Astro.props as Props;
const allPosts = await getPosts();
const pageSize = SITE.postsPerPage;
const start = (current - 1) * pageSize;
const pagePosts = allPosts.slice(start, start + pageSize);

const hrefForPage = (n: number) => sitePath(n === 1 ? "/" : `/page/${n}/`);
---

<BaseLayout
  title={`${t("list.allPosts")} — ${t("pagination.page")} ${current}`}
>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t("list.allPosts")}</h1>
    <p class="text-base-content/70 text-sm">
      {t("pagination.page")}
      {current}
      {t("pagination.of")}
      {last}
    </p>
  </header>
  <PostList posts={pagePosts} />
  <Pagination currentPage={current} lastPage={last} hrefForPage={hrefForPage} />
</BaseLayout>
