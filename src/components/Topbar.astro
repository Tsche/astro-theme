---
/**
 * Site-style topbar: hamburger (mobile only) | breadcrumb | site title (mobile) | search
 * Sits inside the main column, below the header.
 */
import { t } from "../ui";
import { sitePath } from "../utils/site";

interface Props {
  /**
   * Breadcrumb segments. The last segment is treated as the current page.
   * Pass [] to show only "Home".
   */
  crumbs?: Array<{ label: string; href?: string }>;
}

const { crumbs = [] } = Astro.props;
const home = sitePath("/");
---

<header class="site-topbar" aria-label="Top Bar">
  <div class="flex flex-1 items-center gap-2">
    <nav aria-label="Breadcrumb" class="text-base-content/70 truncate text-sm">
      <ol class="flex items-center gap-1">
        <li>
          <a href={home} class="hover:text-primary">{t("nav.home")}</a>
        </li>
        {
          crumbs.map((crumb, i) => (
            <li class="flex items-center gap-1 truncate">
              <span aria-hidden="true" class="text-base-content/40">
                /
              </span>
              {crumb.href && i < crumbs.length - 1 ? (
                <a href={crumb.href} class="hover:text-primary">
                  {crumb.label}
                </a>
              ) : (
                <span class="text-base-content truncate font-medium">
                  {crumb.label}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</header>
