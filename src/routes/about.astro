---
import { getEntry, render } from "astro:content";
import PageLayout from "@tsche/astro-blog-theme/layouts/PageLayout.astro";
import { SITE } from "@astro-theme-site/config";

const entry = await getEntry("pages", "about");
if (!entry) return Astro.rewrite("/404");
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? SITE.description}
  math={entry.data.math}
>
  <Content />
</PageLayout>
